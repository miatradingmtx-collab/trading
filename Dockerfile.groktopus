# Dockerfile.groktopus
# ----------------------------------------------------
FROM python:3.10-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencias de compilacion para C++ / NumPy
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Instalar dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt scipy litellm langchain-groq groq

# Copiar el codigo fuente completo (incluyendo mia_3d_ui/build precompilado)
COPY . .

# Dar permisos de ejecucion al script
RUN chmod +x start_groktopus.sh

# Exponer el puerto
EXPOSE 8000

# Encender el piso de trading
CMD ["./start_groktopus.sh"]
